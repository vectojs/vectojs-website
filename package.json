{
  "name": "vectojs-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:search-index": "bun run scripts/build-search-index.ts",
    "build:js": "bun run build:search-index && bun build src/index.ts --outdir static/js --splitting --minify --target browser",
    "build:zola": "zola build",
    "build": "bun run build:js && bun run build:zola",
    "dev:js": "bun build src/index.ts --outdir static/js --splitting --watch",
    "dev:zola": "zola serve --drafts",
    "dev": "concurrently \"bun run dev:js\" \"bun run dev:zola\"",
    "format": "oxfmt --write \"src/**/*.{js,ts,jsx,tsx,json}\"",
    "format:check": "oxfmt --check \"src/**/*.{js,ts,jsx,tsx,json}\"",
    "lint": "oxlint --deny-warnings src",
    "lint:md": "markdownlint-cli2 \"content/**/*.md\"",
    "check": "bun run format:check && bun run lint",
    "deploy": "bun run check && bun run build && wrangler pages deploy public/",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@vectojs/core": "1.39.0",
    "@vectojs/devtools": "0.11.2",
    "@vectojs/layout": "0.10.0",
    "@vectojs/markdown": "0.23.0",
    "@vectojs/styles": "0.3.3",
    "@vectojs/ui": "2.20.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "^1.3.14",
    "concurrently": "^9.1.0",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.110.0"
  }
}
