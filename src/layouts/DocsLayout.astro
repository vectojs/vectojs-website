---
import Base from './Base.astro';
import { LEARN_PAGES, REFERENCE_PAGES, VERSIONS, SITE } from '../consts';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description?: string;
  collection: 'learn' | 'reference';
  slug: string;
  headings: MarkdownHeading[];
  readingTime?: number;
}

const { title, description, collection, slug, headings, readingTime } = Astro.props;

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

// Group Reference pages by their `group` key, preserving array order, so a
// package with several pages (currently only `ui`) renders as one collapsible
// section instead of dozens of flat sidebar rows. A group with exactly one
// page renders as a plain link — a disclosure triangle over a single item is
// pure friction, and most packages only have one reference page today.
interface ReferenceGroup {
  key: string;
  header: (typeof REFERENCE_PAGES)[number];
  children: (typeof REFERENCE_PAGES)[number][];
}
const referenceGroups: ReferenceGroup[] = [];
for (const page of REFERENCE_PAGES) {
  const key = page.group ?? page.slug;
  const existing = referenceGroups.find((g) => g.key === key);
  if (existing) existing.children.push(page);
  else referenceGroups.push({ key, header: page, children: [] });
}

// Build a flat list of all pages for prev/next navigation.
const allPages = [
  ...LEARN_PAGES.map((p) => ({ ...p, collection: 'learn' as const })),
  ...REFERENCE_PAGES.map((p) => ({ ...p, collection: 'reference' as const })),
];
const currentIdx = allPages.findIndex((p) => p.collection === collection && p.slug === slug);
const prevPage = currentIdx > 0 ? allPages[currentIdx - 1] : null;
const nextPage = currentIdx < allPages.length - 1 ? allPages[currentIdx + 1] : null;
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <!-- Sandboxes import the published packages from esm.sh. Start DNS/TLS while
         the article renders so lazy iframes do not pay that cost on first interaction. -->
    <link rel="preconnect" href="https://esm.sh" crossorigin="anonymous" />
    <link rel="dns-prefetch" href="https://esm.sh" />
    <!-- KaTeX: render $...$ and $$...$$ math in docs pages -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+"
      crossorigin="anonymous"
    />
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"
      integrity="sha384-7zkQWkzuo3B5mTepMUcHkMB5jZaolc2xDwL6VFqjFALcbeS9Ggm/Yr2r3Dy4lfFg"
      crossorigin="anonymous"></script>
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"
      integrity="sha384-43gviWU0YVjaDtb/GhzOouOXtZMP/7XUzwPTstBeZFe/+rCMvRwr4yROQP43s0Xk"
      crossorigin="anonymous"
      onload="renderMathInElement(document.body,{delimiters:[{left:'$$',right:'$$',display:true},{left:'$',right:'$',display:false}],ignoredTags:['script','noscript','style','textarea','pre','code'],throwOnError:false})"
    ></script>
  </Fragment>

  <!-- Mobile nav strip -->
  <div class="docs-mobile-strip">
    <button
      class="docs-mobile-menu-btn"
      id="docs-drawer-open"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="docs-sidebar"
    >
      <svg
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <line x1="3" y1="5" x2="17" y2="5" stroke-linecap="round"></line>
        <line x1="3" y1="10" x2="17" y2="10" stroke-linecap="round"></line>
        <line x1="3" y1="15" x2="17" y2="15" stroke-linecap="round"></line>
      </svg>
      <span>Menu</span>
    </button>
    <span class="docs-mobile-current">{title}</span>
  </div>

  <!-- Drawer backdrop (mobile) -->
  <div class="docs-drawer-backdrop" id="docs-drawer-backdrop" aria-hidden="true"></div>

  <div class="docs-layout" id="docs-layout">
    <!-- Left sidebar: full docs tree (also acts as mobile drawer) -->
    <aside class="docs-sidebar" id="docs-sidebar" aria-label="Documentation navigation">
      <nav class="sidebar-nav">
        <!-- Only the active section's tree — showing Learn's ~17 pages AND
             Reference's ~30 together made the sidebar excessively long. The
             top nav already has both "Learn" and "Reference" links for
             switching sections. -->
        {
          collection === 'learn' ? (
            <div class="sidebar-group">
              <span class="sidebar-group-label">Learn</span>
              {LEARN_PAGES.map((page) => (
                <a
                  href={`/learn/${page.slug}/`}
                  class:list={['sidebar-link', { active: slug === page.slug }]}
                >
                  {page.title}
                </a>
              ))}
            </div>
          ) : (
            <div class="sidebar-group">
              <span class="sidebar-group-label">Reference</span>
              {referenceGroups.map((g) =>
                g.children.length === 0 ? (
                  <a
                    href={`/reference/${g.header.slug}/`}
                    class:list={['sidebar-link', { active: slug === g.header.slug }]}
                  >
                    {g.header.title}
                  </a>
                ) : (
                  <details
                    class="sidebar-collapsible"
                    open={slug === g.header.slug || g.children.some((c) => c.slug === slug)}
                  >
                    <summary class="sidebar-collapsible-summary">
                      <span class="sidebar-collapsible-label">{g.header.title}</span>
                      <svg
                        class="sidebar-collapsible-chevron"
                        viewBox="0 0 20 20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                      >
                        <polyline
                          points="6,8 10,12 14,8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </summary>
                    <div class="sidebar-collapsible-body">
                      {[g.header, ...g.children].map((page) => (
                        <a
                          href={`/reference/${page.slug}/`}
                          class:list={['sidebar-link', { active: slug === page.slug }]}
                        >
                          {page.title}
                        </a>
                      ))}
                    </div>
                  </details>
                ),
              )}
            </div>
          )
        }
      </nav>
      <!-- Outside .sidebar-nav (which scrolls) so this footer stays pinned at
           the bottom of the panel regardless of how tall the nav content is
           (e.g. a collapsible group expanded) instead of scrolling out of view. -->
      <div class="sidebar-versions">
        <span class="sidebar-version-chip">core v{VERSIONS.core}</span>
        <span class="sidebar-version-chip">ui v{VERSIONS.ui}</span>
      </div>
      <div
        class="sidebar-resize-handle"
        id="sidebar-resize-handle"
        role="separator"
        aria-orientation="vertical"
        aria-label="Resize navigation sidebar"
        tabindex="0"
      >
      </div>
    </aside>

    <!-- Main article content -->
    <article class="docs-content prose">
      {
        readingTime && (
          <p
            class="reading-time"
            aria-label={`Estimated reading time: ${readingTime} minute${
              readingTime !== 1 ? 's' : ''
            }`}
          >
            {readingTime} min read
          </p>
        )
      }
      <slot />

      <!-- Feedback widget -->
      <div class="feedback-widget">
        <span class="feedback-label">Was this page helpful?</span>
        <div class="feedback-btns">
          <a
            href={`${SITE.github}/issues/new?labels=documentation&title=${encodeURIComponent(
              `Docs helpful: ${title}`,
            )}&body=${encodeURIComponent(`Page: /${collection}/${slug}/`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="feedback-btn feedback-yes">Yes</a
          >
          <a
            href={`${SITE.github}/issues/new?labels=documentation&title=${encodeURIComponent(
              `Docs needs work: ${title}`,
            )}&body=${encodeURIComponent(
              `Page: /${collection}/${slug}/\n\nWhat was unclear or missing:\n`,
            )}`}
            target="_blank"
            rel="noopener noreferrer"
            class="feedback-btn feedback-no">Needs work</a
          >
        </div>
      </div>

      <!-- Prev / Next navigation -->
      <nav class="docs-pagination" aria-label="Page navigation">
        {
          prevPage && (
            <a
              href={`/${prevPage.collection}/${prevPage.slug}/`}
              class="docs-pagination-link docs-pagination-prev"
            >
              <span class="pagination-label">← Previous</span>
              <span class="pagination-title">{prevPage.title}</span>
            </a>
          )
        }
        {
          nextPage && (
            <a
              href={`/${nextPage.collection}/${nextPage.slug}/`}
              class="docs-pagination-link docs-pagination-next"
            >
              <span class="pagination-label">Next →</span>
              <span class="pagination-title">{nextPage.title}</span>
            </a>
          )
        }
      </nav>
    </article>

    <!-- Right sticky TOC -->
    <aside class="docs-toc" aria-label="Table of contents">
      {
        tocHeadings.length > 0 && (
          <Fragment>
            <nav class="toc-nav">
              <span class="toc-label">On this page</span>
              {tocHeadings.map((h) => (
                <a href={`#${h.slug}`} class:list={['toc-link', `toc-depth-${h.depth}`]}>
                  {h.text}
                </a>
              ))}
            </nav>
          </Fragment>
        )
      }
      <div
        class="toc-resize-handle"
        id="toc-resize-handle"
        role="separator"
        aria-orientation="vertical"
        aria-label="Resize table of contents"
        tabindex="0"
      >
      </div>
    </aside>
  </div>

  <!-- Sidebar collapse handle (Obsidian-style: rides the divider, always visible) -->
  <button
    class="sidebar-expand-btn"
    id="sidebar-expand-btn"
    type="button"
    aria-label="Collapse navigation sidebar"
    title="Toggle sidebar"
  >
    <svg
      class="collapse-icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="11 7 6 12 11 17"></polyline>
      <polyline points="17 7 12 12 17 17"></polyline>
    </svg>
  </button>

  <!-- TOC collapse handle (mirrors the sidebar) -->
  <button
    class="toc-expand-btn"
    id="toc-expand-btn"
    type="button"
    aria-label="Collapse table of contents"
    title="Toggle table of contents"
  >
    <svg
      class="collapse-icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="11 7 6 12 11 17"></polyline>
      <polyline points="17 7 12 12 17 17"></polyline>
    </svg>
  </button>

  <!-- Reading progress bar -->
  <div class="reading-progress-bar" id="reading-progress" aria-hidden="true"></div>

  <!-- Back to top button -->
  <button class="back-to-top" id="back-to-top" aria-label="Scroll back to top" hidden>
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <polyline points="4,13 10,7 16,13" stroke-linecap="round" stroke-linejoin="round"></polyline>
    </svg>
  </button>
</Base>

<script>
  // ── Table horizontal scroll wrapper ───────────────────────────
  document.querySelectorAll<HTMLTableElement>('.prose table').forEach((tbl) => {
    const wrap = document.createElement('div');
    wrap.className = 'table-scroll-wrapper';
    tbl.parentNode!.insertBefore(wrap, tbl);
    wrap.appendChild(tbl);
  });

  // ── Code copy buttons + language badges ────────────────────────
  document.querySelectorAll<HTMLPreElement>('.prose pre.astro-code').forEach((pre) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block-wrapper';
    pre.parentNode!.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    // Language badge (from data-language attr Shiki sets)
    const lang = pre.getAttribute('data-language');
    if (lang) {
      const badge = document.createElement('span');
      badge.className = 'code-lang-badge';
      badge.textContent = lang;
      wrapper.appendChild(badge);
    }

    // Copy button
    const btn = document.createElement('button');
    btn.className = 'code-copy-btn';
    btn.textContent = 'Copy';
    btn.setAttribute('aria-label', 'Copy code to clipboard');
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.innerText ?? pre.innerText;
      let copied = false;
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(code);
          copied = true;
        }
      } catch {}
      if (!copied) {
        const textarea = document.createElement('textarea');
        textarea.value = code;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        const execCommand = Reflect.get(document, 'execCommand') as
          ((command: string) => boolean) | undefined;
        copied = execCommand?.call(document, 'copy') ?? false;
        textarea.remove();
      }
      btn.textContent = copied ? '✓ Copied' : 'Copy failed';
      btn.setAttribute(
        'aria-label',
        copied ? 'Code copied to clipboard' : 'Unable to copy code to clipboard',
      );
      btn.classList.toggle('copied', copied);
      setTimeout(() => {
        btn.textContent = 'Copy';
        btn.setAttribute('aria-label', 'Copy code to clipboard');
        btn.classList.remove('copied');
      }, 2000);
    });
    wrapper.appendChild(btn);
  });

  // ── Heading anchor links ───────────────────────────────────────
  document.querySelectorAll<HTMLHeadingElement>('.prose h2, .prose h3').forEach((h) => {
    if (!h.id) return;
    const a = document.createElement('a');
    a.href = `#${h.id}`;
    a.className = 'heading-anchor';
    a.setAttribute('aria-label', `Link to ${h.textContent}`);
    a.textContent = '#';
    h.appendChild(a);
  });

  // ── TOC active heading ─────────────────────────────────────────
  // Highlight the TOC link for the heading currently in the viewport.
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
  if (tocLinks.length > 0) {
    const headingEls = Array.from(tocLinks)
      .map((a) => {
        const id = a.getAttribute('href')?.slice(1);
        return id ? document.getElementById(id) : null;
      })
      .filter(Boolean) as HTMLElement[];

    const obs = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            tocLinks.forEach((a) => a.classList.remove('toc-active'));
            const active = document.querySelector<HTMLAnchorElement>(
              `.toc-link[href="#${entry.target.id}"]`,
            );
            active?.classList.add('toc-active');
            break;
          }
        }
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );

    headingEls.forEach((el) => obs.observe(el));
  }

  // ── Mobile sidebar drawer ──────────────────────────────────────
  const drawer = document.getElementById('docs-sidebar') as HTMLElement;
  const backdrop = document.getElementById('docs-drawer-backdrop') as HTMLElement;
  const openBtn = document.getElementById('docs-drawer-open') as HTMLButtonElement;
  const mobileDrawerQuery = window.matchMedia('(max-width: 768px)');

  function syncDrawerAccessibility(): void {
    const isOpen = drawer.classList.contains('drawer-open');
    const isHiddenMobileDrawer = mobileDrawerQuery.matches && !isOpen;
    drawer.inert = isHiddenMobileDrawer;
    if (isHiddenMobileDrawer) drawer.setAttribute('aria-hidden', 'true');
    else drawer.removeAttribute('aria-hidden');

    if (!mobileDrawerQuery.matches) {
      drawer.classList.remove('drawer-open');
      backdrop.classList.remove('drawer-open');
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
  }

  function openDrawer(): void {
    drawer.classList.add('drawer-open');
    backdrop.classList.add('drawer-open');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    syncDrawerAccessibility();
    requestAnimationFrame(() => {
      const initialFocus =
        drawer.querySelector<HTMLElement>('.sidebar-link.active') ??
        drawer.querySelector<HTMLElement>('a');
      initialFocus?.focus();
    });
  }

  function closeDrawer(returnFocus = false): void {
    drawer.classList.remove('drawer-open');
    backdrop.classList.remove('drawer-open');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    syncDrawerAccessibility();
    if (returnFocus) openBtn.focus();
  }

  openBtn.addEventListener('click', openDrawer);
  backdrop.addEventListener('click', () => closeDrawer(true));

  // Close drawer when a nav link is clicked (navigating away)
  drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => closeDrawer()));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer.classList.contains('drawer-open')) closeDrawer(true);
  });
  mobileDrawerQuery.addEventListener('change', syncDrawerAccessibility);
  syncDrawerAccessibility();

  // ── Back to top + reading progress bar ────────────────────────
  const backBtn = document.getElementById('back-to-top') as HTMLButtonElement;
  const progressBar = document.getElementById('reading-progress') as HTMLElement;

  window.addEventListener(
    'scroll',
    () => {
      backBtn.hidden = window.scrollY < 400;

      const total = document.documentElement.scrollHeight - window.innerHeight;
      const pct = total > 0 ? window.scrollY / total : 0;
      progressBar.style.transform = `scaleX(${pct})`;
    },
    { passive: true },
  );
  backBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

  // ── Sidebar + TOC collapse (desktop only) ─────────────────────
  // One fixed tab per side toggles its panel. Both tabs share the same fixed top,
  // so the arrows always line up — whether a panel is open or hidden.
  const docsLayout = document.getElementById('docs-layout') as HTMLElement;
  const sidebarTab = document.getElementById('sidebar-expand-btn') as HTMLButtonElement | null;
  const tocTab = document.getElementById('toc-expand-btn') as HTMLButtonElement | null;

  const setSidebar = (collapsed: boolean): void => {
    docsLayout.classList.toggle('sidebar-collapsed', collapsed);
    // Icon direction is CSS-driven off the collapsed class; keep the label in sync.
    sidebarTab?.setAttribute(
      'aria-label',
      collapsed ? 'Expand navigation sidebar' : 'Collapse navigation sidebar',
    );
    try {
      localStorage.setItem('sidebar-collapsed', collapsed ? '1' : '0');
    } catch {}
  };
  const setToc = (collapsed: boolean): void => {
    docsLayout.classList.toggle('toc-collapsed', collapsed);
    tocTab?.setAttribute(
      'aria-label',
      collapsed ? 'Expand table of contents' : 'Collapse table of contents',
    );
    try {
      localStorage.setItem('toc-collapsed', collapsed ? '1' : '0');
    } catch {}
  };

  let sidebarStart = false;
  let tocStart = false;
  try {
    sidebarStart = localStorage.getItem('sidebar-collapsed') === '1';
    tocStart = localStorage.getItem('toc-collapsed') === '1';
  } catch {}
  setSidebar(sidebarStart);
  setToc(tocStart);

  sidebarTab?.addEventListener('click', () =>
    setSidebar(!docsLayout.classList.contains('sidebar-collapsed')),
  );
  tocTab?.addEventListener('click', () => setToc(!docsLayout.classList.contains('toc-collapsed')));

  // ── Sidebar + TOC drag-to-resize (desktop only) ────────────────
  // Both handles write directly to the same --sidebar-w/--toc-w custom
  // properties the grid template and collapse-handle transforms already
  // read, so .docs-content reflows live with no extra layout code, and the
  // collapse handles stay correctly positioned mid-drag.
  const MIN_SIDEBAR_W = 200;
  const MAX_SIDEBAR_W = 440;
  const MIN_TOC_W = 170;
  const MAX_TOC_W = 360;

  function setupResizeHandle(
    handle: HTMLElement | null,
    cssVar: '--sidebar-w' | '--toc-w',
    storageKey: string,
    min: number,
    max: number,
    computeWidth: (startWidth: number, dx: number) => number,
  ): void {
    if (!handle) return;

    const applyWidth = (px: number): void => {
      document.documentElement.style.setProperty(cssVar, `${px}px`);
    };

    let startX = 0;
    let startWidth = 0;

    const onPointerMove = (e: PointerEvent): void => {
      const next = Math.min(max, Math.max(min, computeWidth(startWidth, e.clientX - startX)));
      applyWidth(next);
    };

    const onPointerUp = (e: PointerEvent): void => {
      handle.classList.remove('is-resizing');
      handle.releasePointerCapture(e.pointerId);
      document.removeEventListener('pointermove', onPointerMove);
      document.removeEventListener('pointerup', onPointerUp);
      document.body.style.userSelect = '';
      try {
        const current = getComputedStyle(document.documentElement).getPropertyValue(cssVar).trim();
        if (current) localStorage.setItem(storageKey, current);
      } catch {}
    };

    handle.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startWidth = parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue(cssVar) || `${min}`,
      );
      handle.classList.add('is-resizing');
      handle.setPointerCapture(e.pointerId);
      document.body.style.userSelect = 'none';
      document.addEventListener('pointermove', onPointerMove);
      document.addEventListener('pointerup', onPointerUp);
    });

    // Arrow-key resizing for keyboard/screen-reader users (the handle is a
    // tabbable role="separator").
    handle.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowLeft' ? -16 : e.key === 'ArrowRight' ? 16 : 0;
      if (!step) return;
      e.preventDefault();
      const current = parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue(cssVar) || `${min}`,
      );
      const next = Math.min(max, Math.max(min, current + (cssVar === '--toc-w' ? -step : step)));
      applyWidth(next);
      try {
        localStorage.setItem(storageKey, `${next}px`);
      } catch {}
    });

    try {
      const stored = localStorage.getItem(storageKey);
      if (stored) applyWidth(Math.min(max, Math.max(min, parseFloat(stored))));
    } catch {}
  }

  setupResizeHandle(
    document.getElementById('sidebar-resize-handle'),
    '--sidebar-w',
    'sidebar-width',
    MIN_SIDEBAR_W,
    MAX_SIDEBAR_W,
    (startWidth, dx) => startWidth + dx,
  );
  setupResizeHandle(
    document.getElementById('toc-resize-handle'),
    '--toc-w',
    'toc-width',
    MIN_TOC_W,
    MAX_TOC_W,
    // Dragging the TOC handle left (negative dx) should widen the TOC panel,
    // since the TOC's own edge is on the left and grows toward the content.
    (startWidth, dx) => startWidth - dx,
  );
</script>
