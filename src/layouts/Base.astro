---
import { SITE, BUILD_ID } from '../consts';
import {
  DEFAULT_LOCALE,
  HTML_LANG,
  LOCALE_NAMES,
  PREFIXED_LOCALES,
  isLocale,
  localizedPath,
  parseLocale,
  type Locale,
} from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = SITE.description } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const demos = SITE.gallery;

// Locale is derived from the URL by Astro's i18n routing. `Astro.currentLocale`
// is the configured default ('en') on unprefixed paths and the matching locale
// on /<locale>/… paths, so every page gets a correct locale without threading a
// prop through each route.
const rawLocale = Astro.currentLocale ?? DEFAULT_LOCALE;
const locale: Locale = isLocale(rawLocale) ? rawLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);
const htmlLang = HTML_LANG[locale];

const pathname = Astro.url.pathname;
// Strip any locale prefix before matching sections, so nav highlighting works
// identically on `/reference/…` and `/ja/reference/…`.
const { rest: localeless } = parseLocale(pathname);
const isDemos = localeless.startsWith('/demos');
const isLearn = localeless.startsWith('/learn');
const isReference = localeless.startsWith('/reference');
const isBlog = localeless.startsWith('/blog');
const isHome = localeless === '/' || pathname === '/';

// Localized nav targets. Docs (learn/reference) and home carry the locale
// prefix; the blog and the external Gallery are not localized.
const homeHref = localizedPath('/', locale);
const learnHref = localizedPath('/learn/introduction/', locale);
const referenceHref = localizedPath('/reference/core-api/', locale);

// Language switcher targets: keep the reader on the same doc where possible by
// swapping only the locale prefix on the current path. The blog is English-only,
// so from a blog page every option points at that same English page.
function switchLocaleHref(target: Locale): string {
  if (isBlog) return pathname;
  return localizedPath(localeless, target);
}
---

<!doctype html>
<html lang={htmlLang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <!-- Theme must resolve before any paint: reads the stored preference (else
         system, else dark) and stamps data-theme on <html> synchronously, so the
         SSR default above only ever shows for a first-time dark/no-preference
         visitor — never as a wrong-theme flash for anyone else. Must run before
         the background-color <style> below and before styles.css so both agree
         with the final attribute from the very first paint. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('vecto-theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          /* localStorage/matchMedia unavailable — keep the SSR 'dark' default */
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Paint the right background before any external CSS resolves. Without this,
         a cross-document @view-transition (below) can flash the browser's default
         white canvas on the incoming page for the first frame or two — most visible
         navigating into a blog post, which also waits on the KaTeX CDN stylesheet. -->
    <style>
      html,
      body {
        background-color: #0b0f19;
      }
      html[data-theme='light'],
      html[data-theme='light'] body {
        background-color: #f8fafc;
      }
    </style>
    <!-- Firefox's WebGPU backend SIGSEGVs the whole browser on some Linux/NVIDIA/Wayland
         setups (MozCrashReason "Queue ... does not exist"), and the engine probes
         navigator.gpu on every Scene. Hide WebGPU on Firefox → CPU/WebGL fallback.
         Must run before any engine code; Chromium is unaffected. -->
    <script is:inline>
      (function () {
        if (!/firefox/i.test(navigator.userAgent)) return;
        try {
          Object.defineProperty(navigator, 'gpu', { value: undefined, configurable: true });
        } catch (e) {
          /* fall through */
        }
        try {
          if (navigator.gpu && navigator.gpu.requestAdapter) {
            navigator.gpu.requestAdapter = function () {
              return Promise.resolve(null);
            };
          }
        } catch (e) {
          /* ignore */
        }
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VectoJS" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />

    <!-- Cross-document view transitions (Chrome 126+) -->
    <style>
      @view-transition {
        navigation: auto;
      }
    </style>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;800&family=Playfair+Display:wght@700;800;900&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href={`/css/styles.css?v=${BUILD_ID}`} />
    <slot name="head" />
  </head>
  <body class:list={[{ 'page-docs': isLearn || isReference, 'page-home': isHome }]}>
    <header class="navbar">
      <div class="container nav-container">
        <!-- Left: logo -->
        <a href={homeHref} class="nav-logo" aria-label={t('nav.home')}>
          <svg
            class="nav-logo-mark"
            viewBox="0 0 32 32"
            fill="none"
            stroke="url(#logo-grad)"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M 22 5 L 12 15"></path>
            <path d="M 9 11 L 23 11"></path>
            <path d="M 16 11 L 16 19 L 7 28"></path>
            <path d="M 5 19 L 27 19"></path>
            <path d="M 16 19 L 25 28"></path>
            <circle cx="22" cy="5" r="1.5" fill="url(#logo-grad)" stroke="none"></circle>
            <circle cx="12" cy="15" r="1.5" fill="url(#logo-grad)" stroke="none"></circle>
            <circle cx="9" cy="11" r="1.5" fill="url(#logo-grad)" stroke="none"></circle>
            <circle cx="23" cy="11" r="1.5" fill="url(#logo-grad)" stroke="none"></circle>
            <circle cx="16" cy="11" r="1.5" fill="url(#logo-grad)" stroke="none"></circle>
            <circle cx="16" cy="19" r="1.5" fill="url(#logo-grad)" stroke="none"></circle>
            <circle cx="5" cy="19" r="1.5" fill="url(#logo-grad)" stroke="none"></circle>
            <circle cx="27" cy="19" r="1.5" fill="url(#logo-grad)" stroke="none"></circle>
            <circle cx="7" cy="28" r="1.5" fill="url(#logo-grad)" stroke="none"></circle>
            <circle cx="25" cy="28" r="1.5" fill="url(#logo-grad)" stroke="none"></circle>
            <defs>
              <linearGradient
                id="logo-grad"
                x1="5"
                y1="28"
                x2="27"
                y2="5"
                gradientUnits="userSpaceOnUse"
              >
                <stop offset="0%" stop-color="#6366f1"></stop>
                <stop offset="100%" stop-color="#38bdf8"></stop>
              </linearGradient>
            </defs>
          </svg>
          <span class="nav-logo-text">Vecto</span>
        </a>

        <!-- Center: search trigger -->
        <button
          class="nav-search-trigger"
          id="search-open"
          type="button"
          aria-label={t('search.label')}
        >
          <svg
            class="nav-search-icon"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <circle cx="8.5" cy="8.5" r="5.5"></circle>
            <line x1="13" y1="13" x2="18" y2="18" stroke-linecap="round"></line>
          </svg>
          <span class="nav-search-label">{t('search.short')}</span>
          <kbd class="nav-search-kbd">Ctrl K</kbd>
        </button>

        <!-- Right: nav links + GitHub -->
        <nav class="nav-links" aria-label={t('nav.siteNav')}>
          <a href={demos} class:list={[{ 'nav-link-active': isDemos }]}>{t('nav.gallery')}</a>
          <a href={learnHref} class:list={[{ 'nav-link-active': isLearn }]}>{t('nav.learn')}</a>
          <a href={referenceHref} class:list={[{ 'nav-link-active': isReference }]}
            >{t('nav.reference')}</a
          >
          <a href="/blog/" class:list={[{ 'nav-link-active': isBlog }]}>{t('nav.blog')}</a>
          <button
            class="nav-theme-toggle"
            id="theme-toggle"
            type="button"
            aria-label={t('theme.switchLight')}
          >
            <svg
              class="nav-theme-icon nav-theme-icon-sun"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <circle cx="10" cy="10" r="3.5"></circle>
              <path
                d="M10 2v2M10 16v2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M2 10h2M16 10h2M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4"
                stroke-linecap="round"></path>
            </svg>
            <svg
              class="nav-theme-icon nav-theme-icon-moon"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path d="M17 11.5A7 7 0 1 1 8.5 3a5.5 5.5 0 0 0 8.5 8.5Z" stroke-linejoin="round"
              ></path>
            </svg>
          </button>

          <!-- Language switcher (desktop). Progressive-enhancement <details>;
               swaps only the locale prefix to keep the reader on the same doc. -->
          <details class="nav-lang" id="nav-lang-desktop">
            <summary
              class="nav-lang-summary"
              aria-label={t('lang.switcher')}
              title={t('lang.label')}
            >
              <svg
                class="nav-lang-icon"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              >
                <circle cx="10" cy="10" r="7.5"></circle>
                <path
                  d="M2.5 10h15M10 2.5c2 2.4 3 5 3 7.5s-1 5.1-3 7.5c-2-2.4-3-5-3-7.5s1-5.1 3-7.5Z"
                ></path>
              </svg>
              <span class="nav-lang-current">{LOCALE_NAMES[locale]}</span>
            </summary>
            <ul class="nav-lang-menu" role="list">
              <li>
                <a
                  href={switchLocaleHref(DEFAULT_LOCALE)}
                  class:list={[{ 'nav-lang-active': locale === DEFAULT_LOCALE }]}
                  data-set-locale={DEFAULT_LOCALE}
                  hreflang={HTML_LANG[DEFAULT_LOCALE]}
                  lang={HTML_LANG[DEFAULT_LOCALE]}>{LOCALE_NAMES[DEFAULT_LOCALE]}</a
                >
              </li>
              {
                PREFIXED_LOCALES.map((loc) => (
                  <li>
                    <a
                      href={switchLocaleHref(loc)}
                      class:list={[{ 'nav-lang-active': locale === loc }]}
                      data-set-locale={loc}
                      hreflang={HTML_LANG[loc]}
                      lang={HTML_LANG[loc]}
                    >
                      {LOCALE_NAMES[loc]}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
          <a
            href={SITE.github}
            target="_blank"
            rel="noopener noreferrer"
            class="nav-github-link"
            aria-label={t('nav.viewSource')}
          >
            <svg class="nav-github-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
              ></path>
            </svg>
          </a>
        </nav>

        <!-- Mobile: hamburger toggle (shown ≤768px) -->
        <button
          class="nav-menu-toggle"
          id="nav-menu-toggle"
          type="button"
          aria-label={t('nav.openMenu')}
          aria-expanded="false"
          aria-controls="nav-mobile-menu"
        >
          <span class="nav-menu-bar"></span>
          <span class="nav-menu-bar"></span>
          <span class="nav-menu-bar"></span>
        </button>
      </div>

      <!-- Mobile: slide-down menu (shown ≤768px when open) -->
      <nav class="nav-mobile-menu" id="nav-mobile-menu" aria-label={t('nav.mobileNav')}>
        <a href={demos} class:list={[{ 'nav-link-active': isDemos }]}>{t('nav.gallery')}</a>
        <a href={learnHref} class:list={[{ 'nav-link-active': isLearn }]}>{t('nav.learn')}</a>
        <a href={referenceHref} class:list={[{ 'nav-link-active': isReference }]}
          >{t('nav.reference')}</a
        >
        <a href="/blog/" class:list={[{ 'nav-link-active': isBlog }]}>{t('nav.blog')}</a>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer">{t('nav.github')} ↗</a>
        <button
          class="nav-theme-toggle nav-theme-toggle-mobile"
          id="theme-toggle-mobile"
          type="button"
        >
          <svg
            class="nav-theme-icon nav-theme-icon-sun"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <circle cx="10" cy="10" r="3.5"></circle>
            <path
              d="M10 2v2M10 16v2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M2 10h2M16 10h2M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4"
              stroke-linecap="round"></path>
          </svg>
          <svg
            class="nav-theme-icon nav-theme-icon-moon"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path d="M17 11.5A7 7 0 1 1 8.5 3a5.5 5.5 0 0 0 8.5 8.5Z" stroke-linejoin="round"
            ></path>
          </svg>
          <span>{t('theme.toggle')}</span>
        </button>

        <!-- Language switcher: swaps only the locale prefix, keeping the reader
             on the same doc. Progressive enhancement — a plain <details> that
             works without JS. -->
        <details class="nav-lang" id="nav-lang">
          <summary class="nav-lang-summary" aria-label={t('lang.switcher')} title={t('lang.label')}>
            <svg
              class="nav-lang-icon"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <circle cx="10" cy="10" r="7.5"></circle>
              <path d="M2.5 10h15M10 2.5c2 2.4 3 5 3 7.5s-1 5.1-3 7.5c-2-2.4-3-5-3-7.5s1-5.1 3-7.5Z"
              ></path>
            </svg>
            <span class="nav-lang-current">{LOCALE_NAMES[locale]}</span>
          </summary>
          <ul class="nav-lang-menu" role="list">
            <li>
              <a
                href={switchLocaleHref(DEFAULT_LOCALE)}
                class:list={[{ 'nav-lang-active': locale === DEFAULT_LOCALE }]}
                data-set-locale={DEFAULT_LOCALE}
                hreflang={HTML_LANG[DEFAULT_LOCALE]}
                lang={HTML_LANG[DEFAULT_LOCALE]}>{LOCALE_NAMES[DEFAULT_LOCALE]}</a
              >
            </li>
            {
              PREFIXED_LOCALES.map((loc) => (
                <li>
                  <a
                    href={switchLocaleHref(loc)}
                    class:list={[{ 'nav-lang-active': locale === loc }]}
                    data-set-locale={loc}
                    hreflang={HTML_LANG[loc]}
                    lang={HTML_LANG[loc]}
                  >
                    {LOCALE_NAMES[loc]}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </nav>
    </header>

    <!-- Search modal overlay -->
    <div
      class="search-modal"
      id="search-modal"
      role="dialog"
      aria-modal="true"
      aria-label={t('search.dialog')}
      data-search-index={localizedPath('/search-index.json', locale)}
      data-hint={t('search.hint')}
      data-no-results={t('search.noResults')}
      hidden
    >
      <div class="search-backdrop" id="search-backdrop"></div>
      <div class="search-panel">
        <div class="search-field">
          <svg
            class="search-field-icon"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <circle cx="8.5" cy="8.5" r="5.5"></circle>
            <line x1="13" y1="13" x2="18" y2="18" stroke-linecap="round"></line>
          </svg>
          <input
            type="search"
            class="search-field-input"
            id="search-input"
            placeholder={t('search.placeholder')}
            autocomplete="off"
            spellcheck="false"
          />
          <kbd class="search-field-esc">Esc</kbd>
        </div>
        <div
          class="search-body"
          id="search-results"
          role="listbox"
          aria-label={t('search.results')}
        >
          <p class="search-empty" id="search-hint">{t('search.hint')}</p>
        </div>
      </div>
    </div>

    <!-- Keyboard shortcut help panel -->
    <div
      class="shortcuts-modal"
      id="shortcuts-modal"
      role="dialog"
      aria-modal="true"
      aria-label={t('shortcuts.title')}
      hidden
    >
      <div class="shortcuts-backdrop" id="shortcuts-backdrop"></div>
      <div class="shortcuts-panel">
        <div class="shortcuts-header">
          <span class="shortcuts-title">{t('shortcuts.title')}</span>
          <button class="shortcuts-close" id="shortcuts-close" aria-label={t('shortcuts.close')}
            >✕</button
          >
        </div>
        <dl class="shortcuts-list">
          <div class="shortcut-row">
            <dt><kbd>Ctrl</kbd> <kbd>K</kbd></dt>
            <dd>{t('shortcuts.openSearch')}</dd>
          </div>
          <div class="shortcut-row">
            <dt><kbd>↑</kbd> <kbd>↓</kbd></dt>
            <dd>{t('shortcuts.navResults')}</dd>
          </div>
          <div class="shortcut-row">
            <dt><kbd>Enter</kbd></dt>
            <dd>{t('shortcuts.openResult')}</dd>
          </div>
          <div class="shortcut-row">
            <dt><kbd>Esc</kbd></dt>
            <dd>{t('shortcuts.closeModal')}</dd>
          </div>
          <div class="shortcut-row">
            <dt><kbd>?</kbd></dt>
            <dd>{t('shortcuts.showHelp')}</dd>
          </div>
        </dl>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-container">
        <p>{t('footer.copyright')}</p>
        <div class="footer-links">
          <a href={SITE.github}>GitHub</a>
          <a href="https://astro.build">Astro</a>
        </div>
      </div>
    </footer>

    <script>
      interface SearchEntry {
        title: string;
        snippet?: string;
        href: string;
        section: string;
        depth: number;
      }

      const modal = document.getElementById('search-modal') as HTMLElement;
      const input = document.getElementById('search-input') as HTMLInputElement;
      const openBtn = document.getElementById('search-open') as HTMLButtonElement;
      const backdrop = document.getElementById('search-backdrop') as HTMLElement;
      const resultsBox = document.getElementById('search-results') as HTMLElement;
      const hint = document.getElementById('search-hint') as HTMLElement;

      let INDEX: SearchEntry[] = [];
      let indexLoaded = false;

      // Locale-aware index URL + copy, injected server-side via data attributes.
      const SEARCH_INDEX_URL = modal.dataset.searchIndex || '/search-index.json';
      const HINT_TEXT = modal.dataset.hint || 'Start typing to search…';
      const NO_RESULTS_TPL = modal.dataset.noResults || 'No results for "{query}"';

      async function ensureIndex(): Promise<void> {
        if (indexLoaded) return;
        try {
          const res = await fetch(SEARCH_INDEX_URL);
          INDEX = await res.json();
          indexLoaded = true;
        } catch {
          INDEX = [];
          indexLoaded = true;
        }
      }

      let activeIdx = -1;
      let resultLinks: HTMLAnchorElement[] = [];

      function highlight(text: string, q: string): string {
        if (!q) return text;
        const idx = text.toLowerCase().indexOf(q.toLowerCase());
        if (idx === -1) return text;
        return (
          text.slice(0, idx) +
          `<mark>${text.slice(idx, idx + q.length)}</mark>` +
          text.slice(idx + q.length)
        );
      }

      function renderResults(query: string): void {
        const q = query.trim().toLowerCase();
        if (!q) {
          resultsBox.innerHTML = '';
          resultsBox.appendChild(hint);
          hint.textContent = HINT_TEXT;
          activeIdx = -1;
          resultLinks = [];
          return;
        }

        const matches = INDEX.filter(
          (e) =>
            e.title.toLowerCase().includes(q) ||
            e.href.toLowerCase().includes(q) ||
            (e.snippet?.toLowerCase().includes(q) ?? false),
        ).slice(0, 20);

        if (matches.length === 0) {
          resultsBox.innerHTML = '';
          hint.textContent = NO_RESULTS_TPL.replace('{query}', query);
          resultsBox.appendChild(hint);
          resultLinks = [];
          return;
        }

        const frag = document.createDocumentFragment();
        resultLinks = matches.map((entry) => {
          const a = document.createElement('a');
          a.href = entry.href;
          a.className = `search-result-item${entry.depth > 0 ? ' search-result-heading' : ''}`;
          a.setAttribute('role', 'option');
          const prefix = entry.depth > 0 ? `<span class="search-result-hash">#</span>` : '';
          const snippetHtml = entry.snippet
            ? `<span class="search-result-snippet">${highlight(entry.snippet, query.trim())}</span>`
            : '';
          a.innerHTML = `<span class="search-result-section">${
            entry.section
          }</span><span class="search-result-title">${prefix}${highlight(
            entry.title,
            query.trim(),
          )}</span>${snippetHtml}`;
          a.addEventListener('click', closeSearch);
          frag.appendChild(a);
          return a;
        });

        resultsBox.innerHTML = '';
        resultsBox.appendChild(frag);
        activeIdx = -1;
      }

      function setActive(idx: number): void {
        resultLinks.forEach((a) => a.classList.remove('search-result-active'));
        activeIdx = Math.max(-1, Math.min(idx, resultLinks.length - 1));
        if (activeIdx >= 0) resultLinks[activeIdx].classList.add('search-result-active');
      }

      async function openSearch(): Promise<void> {
        modal.hidden = false;
        input.focus();
        document.body.style.overflow = 'hidden';
        await ensureIndex();
        renderResults(input.value);
      }

      function closeSearch(): void {
        modal.hidden = true;
        input.value = '';
        document.body.style.overflow = '';
        renderResults('');
      }

      openBtn.addEventListener('click', openSearch);
      backdrop.addEventListener('click', closeSearch);
      input.addEventListener('input', () => renderResults(input.value));

      input.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          setActive(activeIdx + 1);
          resultLinks[activeIdx]?.scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          setActive(activeIdx - 1);
          resultLinks[activeIdx]?.scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'Enter' && activeIdx >= 0) {
          e.preventDefault();
          resultLinks[activeIdx].click();
        }
      });

      // Shortcuts panel
      const shortcutsModal = document.getElementById('shortcuts-modal') as HTMLElement;
      const shortcutsBackdrop = document.getElementById('shortcuts-backdrop') as HTMLElement;
      const shortcutsClose = document.getElementById('shortcuts-close') as HTMLButtonElement;

      function openShortcuts(): void {
        shortcutsModal.hidden = false;
        document.body.style.overflow = 'hidden';
      }
      function closeShortcuts(): void {
        shortcutsModal.hidden = true;
        document.body.style.overflow = '';
      }
      shortcutsBackdrop?.addEventListener('click', closeShortcuts);
      shortcutsClose?.addEventListener('click', closeShortcuts);

      document.addEventListener('keydown', (e: KeyboardEvent) => {
        const inInput = (document.activeElement as HTMLElement)?.tagName === 'INPUT';
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          if (modal.hidden) openSearch();
          else closeSearch();
        }
        if (e.key === 'Escape') {
          if (!modal.hidden) closeSearch();
          if (!shortcutsModal.hidden) closeShortcuts();
        }
        if (e.key === '?' && !inInput && modal.hidden && shortcutsModal.hidden) {
          e.preventDefault();
          openShortcuts();
        }
      });

      // Mobile hamburger menu
      const navToggle = document.getElementById('nav-menu-toggle') as HTMLButtonElement | null;
      const navMenu = document.getElementById('nav-mobile-menu') as HTMLElement | null;
      if (navToggle && navMenu) {
        const setMenu = (open: boolean) => {
          navMenu.classList.toggle('is-open', open);
          navToggle.classList.toggle('is-open', open);
          navToggle.setAttribute('aria-expanded', String(open));
          navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        };
        navToggle.addEventListener('click', () => setMenu(!navMenu.classList.contains('is-open')));
        navMenu.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) setMenu(false);
        });
        document.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Escape') setMenu(false);
        });
      }

      // Theme toggle — data-theme was already stamped pre-paint (see <head>);
      // this only handles switching it afterward and persisting the choice.
      const themeToggles = document.querySelectorAll<HTMLButtonElement>(
        '#theme-toggle, #theme-toggle-mobile',
      );
      const applyThemeLabel = (theme: string): void => {
        const label = theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme';
        themeToggles.forEach((btn) => btn.setAttribute('aria-label', label));
      };
      applyThemeLabel(document.documentElement.getAttribute('data-theme') ?? 'dark');
      themeToggles.forEach((btn) => {
        btn.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme') ?? 'dark';
          const next = current === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('vecto-theme', next);
          } catch (e) {
            /* private browsing / storage disabled — theme still applies this session */
          }
          applyThemeLabel(next);
        });
      });

      // Language switcher — persist the chosen locale in the `locale` cookie so
      // the homepage redirect Function (functions/index.js) treats it as the
      // manual override on future visits and never geo-redirects against it.
      // The anchors still navigate normally; this only records the intent.
      document.querySelectorAll<HTMLAnchorElement>('a[data-set-locale]').forEach((link) => {
        link.addEventListener('click', () => {
          const loc = link.dataset.setLocale;
          if (loc) {
            document.cookie = `locale=${encodeURIComponent(loc)}; Path=/; Max-Age=31536000; SameSite=Lax`;
          }
        });
      });
    </script>
  </body>
</html>
