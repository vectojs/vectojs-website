---
/**
 * Shared homepage body, rendered from the locale-aware home dictionary. Both the
 * English homepage (`src/pages/index.astro`) and the localized homepage
 * (`src/pages/[locale]/index.astro`) render this inside <Base>. Locale is read
 * from `Astro.currentLocale` (Base derives it the same way), so this component
 * takes no props. Card/tile bodies contain trusted author HTML (set:html).
 */
import { SITE } from '../consts';
import { isLocale, type Locale } from '../i18n/config';
import { getHomeStrings } from '../i18n/home';

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : 'en';
const home = getHomeStrings(locale);
---

<section class="hero-section">
  {/* The entire hero is one VectoJS canvas (zero per-element DOM). */}
  <canvas id="hero-canvas" class="hero-canvas" aria-hidden="true"></canvas>

  {
    /* Accessible / no-JS / SEO text. The canvas draws the same content; its
      interactive controls project their own a11y shadow nodes at runtime. */
  }
  <div class="hero-fallback sr-only">
    <h1>{home.hero.title}</h1>
    <p>{home.hero.tagline}</p>
    <a href={SITE.gallery}>{home.hero.gallery}</a>
    <a href={SITE.github}>{home.hero.github}</a>
  </div>
</section>

<section class="features-section container">
  <h2 class="section-title">{home.features.title}</h2>
  <div class="features-grid wide">
    {
      home.features.cards.map((card) => (
        <div class="feature-card">
          <div class="feature-icon">{card.icon}</div>
          <h3 set:html={card.title} />
          <p set:html={card.body} />
        </div>
      ))
    }
  </div>
</section>

<section class="usecases-section container">
  <h2 class="section-title">{home.usecases.title}</h2>
  <p class="section-subtitle">{home.usecases.subtitle}</p>
  <div class="usecases-grid">
    {
      home.usecases.tiles.map((tile) => (
        <div class="usecase-tile">
          <div class="usecase-label">{tile.label}</div>
          <h3 set:html={tile.title} />
          <p set:html={tile.body} />
        </div>
      ))
    }
  </div>
</section>
