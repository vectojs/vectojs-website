---
import Base from '../../layouts/Base.astro';
import { demoBySlug, BUILD_ID } from '../../consts';
const demo = demoBySlug('graph3d');
---

<Base title={demo.title} description={demo.description}>
  <link slot="head" rel="stylesheet" href={`/css/demo.css?v=${BUILD_ID}`} />
  <section class="demo-wrap container">
    <header class="demo-head">
      <a class="demo-back" href="/demos/">← All demos</a>
      <h1>{demo.title}</h1>
      <p class="demo-lede">{demo.description}</p>
      <div class="demo-purpose">
        <strong>How to read it:</strong> this is the canonical Les Misérables character co-occurrence
        network — 77 characters, 254 co-appearances, the same dataset used by d3-force and 3d-force-graph's
        own examples. Node size is connection count; color is the novel's 11 character groups. Drag to
        orbit, scroll to zoom, hover a character.
      </div>
    </header>

    <div class="stage stage-graph3d" id="stage" data-immersive>
      <canvas id="graph3d-canvas"></canvas>
      <div class="hud">
        <span>Nodes <b id="hud-graph3d-nodes">0</b></span>
        <span>Links <b id="hud-graph3d-links">0</b></span>
        <span>FPS <b id="hud-graph3d-fps">60</b></span>
      </div>
      <div class="graph-hover-label" id="graph3d-hover-label" hidden></div>
      <div class="nexus-hint">Drag to orbit · scroll to zoom · hover a character</div>
      <div class="dimension-fallback" id="graph3d-fallback" hidden>
        WebGL isn't available in this browser, so the 3D scene can't render.
      </div>
    </div>

    <div class="controls" id="controls">
      <label class="ctl"
        >Charge strength <output id="out-graph3d-charge">-60</output>
        <input
          id="ctl-graph3d-charge"
          type="range"
          min="-200"
          max="-10"
          step="10"
          value="-60"
          autocomplete="off"
        />
      </label>
      <label class="ctl"
        >Link distance <output id="out-graph3d-distance">30</output>
        <input
          id="ctl-graph3d-distance"
          type="range"
          min="5"
          max="100"
          step="5"
          value="30"
          autocomplete="off"
        />
      </label>
      <div class="ctl-actions">
        <button id="ctl-graph3d-reset" type="button">⟳ Re-run layout</button>
        <button id="ctl-report" type="button" class="report-btn">Export report</button>
      </div>
    </div>

    <div class="report-panel" id="report-panel" hidden>
      <div class="report-head">
        <span>Performance report — real browser, real GPU</span>
        <div class="report-actions">
          <button type="button" data-report-copy>Copy JSON</button>
          <button type="button" data-report-download>Download</button>
          <button type="button" data-report-close aria-label="Close">✕</button>
        </div>
      </div>
      <pre id="report-pre"></pre>
    </div>

    <section class="demo-explain">
      <h2>What this demo proves</h2>
      <div class="explain-grid">
        <div class="explain-card explain-win">
          <h4>Two draw calls, any graph size</h4>
          <p>
            <code>@vectojs/graph3d</code>'s <code>Graph3D</code> renderer draws every node as one
            <code>THREE.InstancedMesh</code> and every link as one <code>THREE.LineSegments</code>
            — the draw call count never grows with node count, only the instance buffers do.
          </p>
        </div>
        <div class="explain-card">
          <h4>Pluggable, worker-friendly layout</h4>
          <p>
            Physics runs behind a <code>GraphLayout</code> interface: positions come out as one flat,
            transferable <code>Float32Array</code>, so the same contract can host the simulation in
            a Web Worker without ever touching the render thread. This demo uses
            <code>D3ForceLayout</code>, an adapter over d3-force-3d — the same engine
            <a href="https://github.com/vasturiano/3d-force-graph" target="_blank" rel="noopener"
              >3d-force-graph</a
            > is built on.
          </p>
        </div>
        <div class="explain-card">
          <h4>A real, well-known dataset</h4>
          <p>
            Les Misérables' character co-occurrence graph is the standard reference dataset for
            force-directed layout demos — using it here means the physics and framing are directly
            comparable to every other force-graph library's canonical example.
          </p>
        </div>
      </div>
    </section>
  </section>
</Base>

<script>
  import '../../demos/graph3d';
  import '../../demos/immersive';
</script>
