---
import Base from '../../layouts/Base.astro';
import { demoBySlug, BUILD_ID } from '../../consts';
const demo = demoBySlug('graph');
---

<Base title={demo.title} description={demo.description}>
  <link slot="head" rel="stylesheet" href={`/css/demo.css?v=${BUILD_ID}`} />
  <section class="demo-wrap container">
    <header class="demo-head">
      <a class="demo-back" href="/demos/">← All demos</a>
      <h1>{demo.title}</h1>
      <p class="demo-lede">{demo.description}</p>
      <div class="demo-purpose">
        <strong>How to read it:</strong> the labeled center graph is the real VectoJS concept map. The
        surrounding dots are synthetic load that behave like real graph nodes, so you can pan, zoom, hover,
        and raise the count while the DOM node count stays flat.
      </div>
    </header>

    <div class="stage stage-graph" id="graph-stage" data-immersive>
      <canvas id="graph-canvas"></canvas>
      <div class="hud">
        <span>Nodes <b id="hud-graph-nodes">0</b></span>
        <span>Satellites <b id="hud-graph-sats">0</b></span>
        <span>Edges <b id="hud-graph-edges">0</b></span>
        <span>FPS <b id="hud-graph-fps">60</b></span>
        <span>DOM nodes <b id="hud-graph-dom">0</b></span>
      </div>
      <div class="graph-hover-label" id="graph-hover-label" hidden></div>
      <div class="nexus-hint">
        Center labels are real concepts · satellite dots are scale load · scroll to zoom · drag to
        pan
      </div>
    </div>

    <div class="controls" id="controls">
      <label class="ctl"
        >Satellite nodes <output id="out-graph-count">4,000</output>
        <input
          id="ctl-graph-count"
          type="range"
          min="500"
          max="20000"
          step="500"
          value="4000"
          autocomplete="off"
        />
      </label>
      <div class="ctl-actions">
        <button id="ctl-graph-reset" type="button">⊙ Recenter</button>
        <button id="ctl-graph-report" type="button" class="report-btn">Export report</button>
      </div>
    </div>

    <div class="report-panel" id="report-panel" hidden>
      <div class="report-head">
        <span>Performance report — real browser, real GPU</span>
        <div class="report-actions">
          <button type="button" data-report-copy>Copy JSON</button>
          <button type="button" data-report-download>Download</button>
          <button type="button" data-report-close aria-label="Close">✕</button>
        </div>
      </div>
      <pre id="report-pre"></pre>
    </div>

    <section class="demo-explain">
      <h2>What this demo proves</h2>
      <div class="explain-grid">
        <div class="explain-card explain-win">
          <h4>Meaningful center, scalable perimeter</h4>
          <p>
            The backbone is the actual VectoJS ecosystem — <code>@vectojs/core</code>,
            <code>ui</code>, <code>three</code>, and Vectomancy — down to real concepts like
            <code>Scene</code> and <code>LayoutEngine</code>. The satellite cloud adds graph-scale
            load around that map without pretending every dot is a hand-written concept.
          </p>
        </div>
        <div class="explain-card">
          <h4>Canvas graph, not DOM node graph</h4>
          <p>
            A traditional SVG or DOM graph pays for every visible node as an element. Here the
            visual surface stays in a VectoJS scene: the real labels are drawn as entities, while
            satellite points are WebGL-batched through <code>ComputeParticleEntity</code>.
          </p>
        </div>
        <div class="explain-card">
          <h4>Hover stays local</h4>
          <p>
            Hovering does not scan the whole graph. The demo queries a spatial hash grid from
            <a href="/learn/math-foundations/">Mathematical Foundations</a>, then tests only the
            cursor cell and its neighbours even as the slider raises the graph into the tens of
            thousands of nodes.
          </p>
        </div>
      </div>
    </section>
  </section>
</Base>

<script>
  import '../../demos/graph';
  import '../../demos/immersive';
</script>
