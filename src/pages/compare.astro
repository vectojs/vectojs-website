---
import Base from '../layouts/Base.astro';
import { BUILD_ID } from '../consts';

const title = 'DOM vs VectoJS — Live Comparison';
const description =
  'Watch the DOM choke while VectoJS holds 60fps, on your own hardware — a steelmanned, same-device, reproducible comparison.';
---

<Base title={title} description={description}>
  <link slot="head" rel="stylesheet" href={`/css/demo.css?v=${BUILD_ID}`} />
  <section class="demo-wrap container">
    <header class="demo-head">
      <a class="demo-back" href="/">← Home</a>
      <h1>{title}</h1>
      <p class="demo-lede">{description}</p>
    </header>

    <div class="controls" id="compare-controls">
      <label for="compare-count">Comment count</label>
      <input type="range" id="compare-count" min="100" max="5000" step="100" value="800" />
      <output id="compare-count-out">800</output>
      <button type="button" id="compare-benchmark">Run fair benchmark</button>
    </div>

    <div class="compare-grid" id="compare-stage" data-immersive>
      <div class="compare-panel">
        <div class="compare-panel-head">
          <h2>Plain DOM</h2>
          <span class="compare-hud" id="dom-hud">— fps · — nodes</span>
        </div>
        <div class="compare-viewport" id="dom-viewport"></div>
      </div>
      <div class="compare-panel">
        <div class="compare-panel-head">
          <h2>VectoJS</h2>
          <span class="compare-hud" id="vecto-hud">— fps · — nodes</span>
        </div>
        <div class="compare-viewport">
          <canvas id="compare-canvas"></canvas>
        </div>
      </div>
    </div>

    <div class="compare-results" id="compare-results" hidden>
      <h2>Fair-benchmark results</h2>
      <p class="compare-crossover" id="compare-crossover"></p>
      <div class="compare-cards" id="compare-cards"></div>
    </div>

    <section class="compare-methodology">
      <h2>Methodology</h2>
      <ol>
        <li>
          The DOM side is <strong>steelmanned</strong>: a fixed element pool (never created or
          destroyed per comment), moved via <code>transform: translate3d</code>, text set once. No <code
            >will-change</code
          > is applied to every element — a competent engineer wouldn't blow up the compositor layer
          count for a stress test either.
        </li>
        <li>
          Both sides consume the <strong>identical seeded workload</strong> — the same text, color, size,
          lane, and speed per comment, byte-for-byte.
        </li>
        <li>
          The <strong>live view</strong> above runs both sides on the same main thread at once, which
          handicaps both (conservative, in VectoJS's favor too) — read it as a vibe check, not a number.
        </li>
        <li>
          The <strong>fair benchmark</strong> runs each side alone, exactly as it would in a real app.
          This is the authoritative measurement.
        </li>
        <li>Numbers come from <strong>your own hardware</strong> — reproducible by definition.</li>
      </ol>
      <p class="compare-source-links">
        <a
          href="https://github.com/vectojs/vectojs-website/blob/main/src/demos/compare/dom-danmaku.ts"
          target="_blank"
          rel="noopener">View DOM implementation</a
        >
        ·
        <a
          href="https://github.com/vectojs/vectojs-website/blob/main/src/demos/compare/vecto-danmaku.ts"
          target="_blank"
          rel="noopener">View VectoJS implementation</a
        >
      </p>
    </section>
  </section>
</Base>

<script>
  import '../demos/compare/compare-page';
  import '../demos/immersive';
</script>

<style>
  .compare-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin: 1.75rem 0 1.25rem;
  }

  @media (max-width: 860px) {
    .compare-grid {
      grid-template-columns: 1fr;
    }
  }

  .compare-grid.is-immersive {
    position: fixed;
    inset: 0;
    z-index: 200;
    margin: 0;
    padding: 2rem;
    background: #05070d;
    grid-template-columns: 1fr 1fr;
  }

  .compare-panel {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .compare-panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .compare-panel-head h2 {
    font-family: var(--font-title);
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
  }

  .compare-hud {
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .compare-viewport {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    background: radial-gradient(900px 400px at 50% -10%, rgba(37, 99, 235, 0.14), transparent 60%),
      linear-gradient(180deg, #0a0e1a 0%, #070a13 100%);
  }

  .compare-viewport canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .compare-results {
    margin-top: 2rem;
    padding: 1.5rem 1.75rem;
    border-radius: 14px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
  }

  .compare-results h2 {
    font-family: var(--font-title);
    font-size: 1.2rem;
    color: #fff;
    margin-bottom: 0.75rem;
  }

  .compare-crossover {
    font-size: 1.05rem;
    color: var(--text-color);
    margin-bottom: 1.25rem;
  }

  .compare-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 860px) {
    .compare-cards {
      grid-template-columns: 1fr;
    }
  }

  .compare-cards :global(.compare-card) {
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1rem 1.25rem;
  }

  .compare-cards :global(.compare-card h3) {
    font-family: var(--font-title);
    font-size: 1rem;
    color: #fff;
    margin-bottom: 0.6rem;
  }

  .compare-cards :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .compare-cards :global(td) {
    padding: 0.3rem 0;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-color);
  }

  .compare-methodology {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }

  .compare-methodology h2 {
    font-family: var(--font-title);
    font-size: 1.3rem;
    color: #fff;
    margin-bottom: 1rem;
  }

  .compare-methodology ol {
    color: var(--text-muted);
    line-height: 1.7;
    padding-left: 1.4rem;
  }

  .compare-methodology li {
    margin-bottom: 0.6rem;
  }

  .compare-source-links {
    margin-top: 1rem;
    font-size: 0.9rem;
  }

  .compare-source-links a {
    color: var(--accent);
  }
</style>
